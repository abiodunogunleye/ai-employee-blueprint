# Secrets and credentials
.env
.env.*
*.key
*.pem
*credentials*
*secret*

# Memory folders: ignore contents, keep the folders via .gitkeep
**/memory/*
!**/memory/.gitkeep

# Inbox and board: live emails and drafts never go in git
**/inbox/*
!**/inbox/.gitkeep
**/board/*
!**/board/.gitkeep

# Claude Code local settings
.claude/settings.local.json

# OS and editor junk
.DS_Store
Thumbs.db
node_modules/
Claude outputs/
